<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="restaurant_qr_activity">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Camera viewpoint when the world opens -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.6 0.6</ambient_light>
        <background_color>0.78 0.82 0.86</background_color>
        <camera_pose>-4 -6 5 0 0.65 0.78</camera_pose>
      </plugin>
    </gui>

    <!-- Floor -->
    <model name="restaurant_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision"><geometry><box><size>8 6 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 6 0.05</size></box></geometry>
          <material><ambient>0.72 0.62 0.48 1</ambient><diffuse>0.72 0.62 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Walls: simple restaurant room, opening near front-right for entry path -->
    <model name="back_wall"><static>true</static><pose>0 3 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>8 0.12 2</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.12 2</size></box></geometry><material><ambient>0.92 0.88 0.78 1</ambient><diffuse>0.92 0.88 0.78 1</diffuse></material></visual></link></model>
    <model name="left_wall"><static>true</static><pose>-4 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.12 6 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 6 2</size></box></geometry><material><ambient>0.92 0.88 0.78 1</ambient><diffuse>0.92 0.88 0.78 1</diffuse></material></visual></link></model>
    <model name="right_wall"><static>true</static><pose>4 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.12 6 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.12 6 2</size></box></geometry><material><ambient>0.92 0.88 0.78 1</ambient><diffuse>0.92 0.88 0.78 1</diffuse></material></visual></link></model>
    <model name="front_wall_left"><static>true</static><pose>-2.5 -3 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3 0.12 2</size></box></geometry></collision><visual name="v"><geometry><box><size>3 0.12 2</size></box></geometry><material><ambient>0.92 0.88 0.78 1</ambient><diffuse>0.92 0.88 0.78 1</diffuse></material></visual></link></model>
    <model name="front_wall_right"><static>true</static><pose>2.9 -3 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.2 0.12 2</size></box></geometry></collision><visual name="v"><geometry><box><size>2.2 0.12 2</size></box></geometry><material><ambient>0.92 0.88 0.78 1</ambient><diffuse>0.92 0.88 0.78 1</diffuse></material></visual></link></model>

    <!-- Counter / host stand -->
    <model name="service_counter"><static>true</static><pose>-2.5 2.35 0.45 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.0 0.55 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 0.55 0.9</size></box></geometry><material><ambient>0.35 0.20 0.12 1</ambient><diffuse>0.35 0.20 0.12 1</diffuse></material></visual></link></model>
    <model name="menu_board"><static>true</static><pose>0.2 2.91 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.5 0.04 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 0.04 0.7</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual></link></model>

    <!-- Tables and chairs. Main driving aisle is kept around y=-2 to y=0. -->
    <model name="table_1"><static>true</static><pose>-2.3 0.75 0.38 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.45</radius><length>0.08</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.32 0.18 1</ambient><diffuse>0.55 0.32 0.18 1</diffuse></material></visual></link></model>
    <model name="table_2"><static>true</static><pose>0.0 0.75 0.38 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.45</radius><length>0.08</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.32 0.18 1</ambient><diffuse>0.55 0.32 0.18 1</diffuse></material></visual></link></model>
    <model name="table_3"><static>true</static><pose>2.3 0.75 0.38 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.45</radius><length>0.08</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.32 0.18 1</ambient><diffuse>0.55 0.32 0.18 1</diffuse></material></visual></link></model>
    <model name="table_4"><static>true</static><pose>-1.2 -1.15 0.38 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.42</radius><length>0.08</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.42</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.32 0.18 1</ambient><diffuse>0.55 0.32 0.18 1</diffuse></material></visual></link></model>
    <model name="table_5"><static>true</static><pose>1.35 -1.15 0.38 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.42</radius><length>0.08</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.42</radius><length>0.08</length></cylinder></geometry><material><ambient>0.55 0.32 0.18 1</ambient><diffuse>0.55 0.32 0.18 1</diffuse></material></visual></link></model>

    <!-- Simple chairs as small blocks -->
    <model name="chair_blocks"><static>true</static>
      <link name="chairs">
        <!-- collision is simplified as one invisible-ish long box, visuals are individual seats -->
        <collision name="c"><geometry><box><size>6.2 3.1 0.32</size></box></geometry><pose>0 0 0.16 0 0 0</pose></collision>
        <visual name="chair_1"><pose>-2.3 0.05 0.22 0 0 0</pose><geometry><box><size>0.36 0.32 0.25</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="chair_2"><pose>-2.3 1.45 0.22 0 0 0</pose><geometry><box><size>0.36 0.32 0.25</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="chair_3"><pose>0.0 0.05 0.22 0 0 0</pose><geometry><box><size>0.36 0.32 0.25</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="chair_4"><pose>0.0 1.45 0.22 0 0 0</pose><geometry><box><size>0.36 0.32 0.25</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="chair_5"><pose>2.3 0.05 0.22 0 0 0</pose><geometry><box><size>0.36 0.32 0.25</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
        <visual name="chair_6"><pose>2.3 1.45 0.22 0 0 0</pose><geometry><box><size>0.36 0.32 0.25</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <!-- QR / activity stations. Pose format: x y z roll pitch yaw. -->
    <include>
      <name>qr_entrance</name>
      <uri>model://restaurant_qr_marker_01</uri>
      <pose>0.95 -2.93 1.10 0 0 0</pose>
    </include>
    <include>
      <name>qr_counter</name>
      <uri>model://restaurant_qr_marker_02</uri>
      <pose>-1.25 2.91 1.25 0 0 3.14159</pose>
    </include>
    <include>
      <name>qr_table_left</name>
      <uri>model://restaurant_qr_marker_03</uri>
      <pose>-3.93 0.6 1.05 0 0 1.5708</pose>
    </include>
    <include>
      <name>qr_table_center</name>
      <uri>model://restaurant_qr_marker_04</uri>
      <pose>0.0 2.91 1.25 0 0 3.14159</pose>
    </include>
    <include>
      <name>qr_table_right</name>
      <uri>model://restaurant_qr_marker_05</uri>
      <pose>3.93 0.45 1.05 0 0 -1.5708</pose>
    </include>
    <include>
      <name>qr_exit</name>
      <uri>model://restaurant_qr_marker_06</uri>
      <pose>3.93 -2.1 1.05 0 0 -1.5708</pose>
    </include>

    <!-- Optional: if your repo already has ackermann_car, this will spawn it. Delete this include if model is missing. -->
    <include>
      <name>robot_car</name>
      <uri>model://ackermann_car</uri>
      <pose>0 -2.25 0.08 0 0 1.5708</pose>
    </include>
  </world>
</sdf>
