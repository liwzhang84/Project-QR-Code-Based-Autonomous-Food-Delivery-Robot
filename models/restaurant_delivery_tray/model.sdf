<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="restaurant_delivery_tray">
    <static>false</static>
    <link name="tray_link">
      <inertial><mass>0.35</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <!-- Tray platform -->
      <visual name="tray_board"><pose>0 0 0.02 0 0 0</pose><geometry><box><size>0.55 0.38 0.04</size></box></geometry><material><ambient>0.55 0.35 0.16 1</ambient><diffuse>0.55 0.35 0.16 1</diffuse></material></visual>
      <collision name="tray_collision"><pose>0 0 0.02 0 0 0</pose><geometry><box><size>0.55 0.38 0.04</size></box></geometry></collision>
      <!-- Raised rim -->
      <visual name="rim_front"><pose>0 -0.20 0.065 0 0 0</pose><geometry><box><size>0.58 0.035 0.05</size></box></geometry><material><ambient>0.42 0.24 0.10 1</ambient><diffuse>0.42 0.24 0.10 1</diffuse></material></visual>
      <visual name="rim_back"><pose>0 0.20 0.065 0 0 0</pose><geometry><box><size>0.58 0.035 0.05</size></box></geometry><material><ambient>0.42 0.24 0.10 1</ambient><diffuse>0.42 0.24 0.10 1</diffuse></material></visual>
      <visual name="rim_left"><pose>-0.29 0 0.065 0 0 0</pose><geometry><box><size>0.035 0.38 0.05</size></box></geometry><material><ambient>0.42 0.24 0.10 1</ambient><diffuse>0.42 0.24 0.10 1</diffuse></material></visual>
      <visual name="rim_right"><pose>0.29 0 0.065 0 0 0</pose><geometry><box><size>0.035 0.38 0.05</size></box></geometry><material><ambient>0.42 0.24 0.10 1</ambient><diffuse>0.42 0.24 0.10 1</diffuse></material></visual>
      <!-- Food plates to show delivery function -->
      <visual name="plate_1"><pose>-0.14 -0.03 0.09 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.015</length></cylinder></geometry><material><ambient>0.95 0.95 0.90 1</ambient><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
      <visual name="food_1"><pose>-0.14 -0.03 0.108 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.018</length></cylinder></geometry><material><ambient>0.90 0.28 0.08 1</ambient><diffuse>0.90 0.28 0.08 1</diffuse></material></visual>
      <visual name="plate_2"><pose>0.14 0.04 0.09 0 0 0</pose><geometry><cylinder><radius>0.085</radius><length>0.015</length></cylinder></geometry><material><ambient>0.95 0.95 0.90 1</ambient><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
      <visual name="food_2"><pose>0.14 0.04 0.108 0 0 0</pose><geometry><sphere><radius>0.055</radius></sphere></geometry><material><ambient>0.25 0.65 0.20 1</ambient><diffuse>0.25 0.65 0.20 1</diffuse></material></visual>
      <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
    </link>
  </model>
</sdf>
